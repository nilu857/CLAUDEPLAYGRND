# API Base URLs for different environments
# DummyJSON is a free REST API with realistic data for testing
# Endpoints: /users, /posts, /comments, /products, /carts, /auth, etc.
# Documentation: https://dummyjson.com/docs
API_BASE_URL=https://dummyjson.com
DEV_API_BASE_URL=https://dummyjson.com
STAGING_API_BASE_URL=https://dummyjson.com
PROD_API_BASE_URL=https://dummyjson.com

# Authentication
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here
AUTH_TOKEN=your_auth_token_here

# Test Configuration
LOG_LEVEL=INFO
RETRY_COUNT=3
RETRY_DELAY=1000
REQUEST_TIMEOUT=30000

# Test User Credentials
TEST_USERNAME=testuser
TEST_PASSWORD=testpassword
TEST_EMAIL=test@example.com

# Feature Flags
ENABLE_RETRY=true
ENABLE_LOGGING=true
ENABLE_SCREENSHOTS=true

# Reporting
ALLURE_RESULTS_DIR=./allure-results
REPORT_OUTPUT_DIR=./test-results
